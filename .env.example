# AIEXNET Defense — environment configuration
#
# The air picture (ADS-B), the space picture (satellite orbits) and the local
# track archive all work with NO keys at all. Each key below unlocks a whole
# layer that is otherwise blank — and the HUD says NO KEY until you set it,
# rather than filling the gap with anything invented.

NEXT_PUBLIC_APP_NAME="AIEXNET Defense"
NEXT_PUBLIC_DEFAULT_DEFCON=3

# --- MARITIME / SHIPS (AIS) -------------------------------------------------
# Free. Sign up at https://aisstream.io/ and create an API key.
# Unlocks: every ship broadcasting AIS in the Bay of Bengal — name, MMSI, IMO,
# flag, course, speed, draught, declared destination, naval/coast-guard flags.
# Also enables AIS gap analysis, which needs reporting history to find gaps in.
# AISSTREAM_API_KEY=""

# --- THERMAL / FIRE / BURN DETECTION (NASA FIRMS) ---------------------------
# Free. Request a MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Unlocks: real VIIRS + MODIS active-fire detections across Bangladesh,
# Myanmar and NE India, refreshed on every satellite overpass.
# NASA_FIRMS_MAP_KEY=""

# --- SENTINEL-1 RADAR / DARK VESSEL DETECTION -------------------------------
# Free. Register at https://dataspace.copernicus.eu/ then create an OAuth
# client under Sentinel Hub settings.
# Unlocks: synthetic aperture radar sweeps of any map area. Radar sees hulls
# regardless of what they broadcast, so a radar target with no AIS vessel near
# it is a vessel running without AIS.
# CDSE_CLIENT_ID=""
# CDSE_CLIENT_SECRET=""

# --- TRACK ARCHIVE (time machine) -------------------------------------------
# Local SQLite recording, on by default. No key needed.
# ARCHIVE_DIR="./data"              # where archive.db lives
# ARCHIVE_RETENTION_DAYS=30         # position history retention
# ARCHIVE_INTERVAL_MS=5000          # snapshot cadence
# ARCHIVE_ENABLED=true              # set false to stop recording

# --- COVERAGE TUNING --------------------------------------------------------
# ADSB_EXTENDED_PER_CYCLE=4         # far-field query points sampled per cycle
# ADSB_MIL_EVERY_N_CYCLES=2         # cycles between global military sweeps
# MIL_MIN_LAT=-20                   # theatre box for the global military feed
# MIL_MAX_LAT=50
# MIL_MIN_LON=35
# MIL_MAX_LON=130
